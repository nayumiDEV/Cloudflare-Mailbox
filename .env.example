# ============================================================
# OTP Inbox — environment
# Copy to `.env` for local use, or paste each value into your
# host's dashboard (Koyeb → your service → Environment).
# ============================================================

# ---------- REQUIRED ----------

# Admin account, created on first boot only. The password is only read when the
# account does not already exist, so changing it later does NOT reset the
# stored password — use the in-app change-password screen for that.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD

# Shared secret between the Cloudflare Worker and this API. The worker must send
# it as the `X-Worker-Token` header. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
WORKER_INGEST_TOKEN=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET


# ---------- DATABASE (pick one) ----------

# Option A — PostgreSQL. Paste the DSN from your provider verbatim.
# Setting this switches the whole app to PostgreSQL automatically.
# DATABASE_URL=postgres://user:password@host:port/dbname

# Option B — SQLite. Used whenever DATABASE_URL is unset. The file lives on the
# container's disk, so it is fine for a single instance but is lost on redeploy
# unless you attach a volume.
DATABASE_PATH=./data/otp_inbox.db


# ---------- SESSION / COOKIE ----------

# Session lifetime in days.
SESSION_DAYS=7

# Keep at 1 in production. Set to 0 only for local HTTP testing, otherwise the
# browser refuses to store the session cookie over plain http.
COOKIE_SECURE=1


# ---------- REFERRAL REGISTRATION (all default OFF) ----------

# Master switch for the self-registration form. A valid referral code is always
# required; this only controls whether the form is reachable. Can also be
# toggled at runtime from the admin dashboard, which overrides this on first boot.
REGISTRATION_ENABLED=0

# Global half of the "code generation" permission. Even when this is on, every
# individual user still starts with the permission DISABLED and must be granted
# it by an admin. Also toggleable at runtime from the dashboard.
REFERRAL_CODE_GENERATION=0

# Days a generated referral code stays valid. 0 = never expires.
REFERRAL_CODE_TTL_DAYS=0

# Default uses granted when a code is created without an explicit value.
REFERRAL_MAX_USES_DEFAULT=1


# ---------- ABUSE LIMITS (0 disables) ----------

LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900
REGISTER_MAX_ATTEMPTS=5
REGISTER_WINDOW_SECONDS=3600


# ---------- EMAIL INGEST LIMITS ----------

MAX_EMAIL_BYTES=10485760
MAX_BODY_CHARS=200000
MAX_ATTACHMENTS_TOTAL=16777216
MAX_ATTACHMENT_BYTES=8388608


# ---------- SEARCH ----------

# How much of a message body goes into the search index. Raise for better
# recall on long emails, at the cost of index size.
FTS_BODY_CHARS=4000


# ---------- OPTIONAL ----------

# Displayed in the UI title and the API.
APP_NAME=OTP Inbox

# Seeded into the domains table on a completely empty database only.
# Replace with your real catch-all domain after first boot (Admin → Domains).
# DEFAULT_MAIL_DOMAIN=example.com

# Force a specific cache-busting value for the static assets. Leave unset: the
# app hashes app.css/app.js itself and changes the value whenever they change.
# ASSET_VERSION=


# ---------- OUTBOUND SEND (optional — Cloudflare Email Sending) ----------
# Requires Workers Paid + domain onboarded under Email Service → Email Sending.
# When set, the UI shows Compose / Sent and POST /api/mailboxes/{id}/send works.
# Point at the Worker fetch handler path "/send" (same WORKER_INGEST_TOKEN auth).
# See docs/en/SEND.md and docs/vi/SEND.md.
# WORKER_SEND_URL=https://otp-inbox-worker.<account>.workers.dev/send

# Caps applied by the API before calling the Worker (Cloudflare hard max: 50 recipients).
# MAX_SEND_RECIPIENTS=50
# MAX_SEND_ATTACHMENTS=10
# MAX_SEND_ATTACHMENT_BYTES=3145728
# MAX_SEND_BODY_CHARS=200000
